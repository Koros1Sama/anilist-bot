# Required
GEMINI_API_KEY=your_gemini_api_key_here
ANILIST_ACCESS_TOKEN=your_anilist_access_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional (recommended for multi-turn memory on Vercel)
GEMINI_MODEL=gemini-2.0-flash
# Persistent storage — Upstash Redis REST or Vercel KV.
# Without these the bot falls back to in-memory (context resets between requests on serverless).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
